# Salin ke /etc/claw3d/studio.env lalu: chmod 600 /etc/claw3d/studio.env
# Gateway OpenClaw lokal (hanya listen di loopback).
CLAW3D_GATEWAY_URL=ws://localhost:18789
CLAW3D_GATEWAY_ADAPTER_TYPE=openclaw
# Isi dengan token gateway dari /opt/openclaw/.openclaw/openclaw.json (gateway.auth.token).
CLAW3D_GATEWAY_TOKEN=<ISI_TOKEN_GATEWAY_OPENCLAW>
# 1 = proxy studio selalu ke gateway di atas (lantai demo tidak bisa memindahkan koneksi).
CLAW3D_LOCK_GATEWAY=1
